+void ggml_vec_dot_q4_hqq_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK8_0;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(qk == QK4_HQQ);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q4_hqq * GGML_RESTRICT x = vx;
+    const block_q8_0   * GGML_RESTRICT y = vy;
+
+    float sumf = 0;
+
+    for (int ib = 0; ib < nb; ++ib) {
+        int sumi = 0;
+        int sumy = 0;
+
+        for (int j = 0; j < qk/2; ++j) {
+            const int v0 = (x[ib].qs[j] & 0x0F);
+            const int v1 = (x[ib].qs[j] >>   4);
+
+            sumi += (v0 * y[ib].qs[j]);
+            sumi += (v1 * y[ib].qs[j + qk/2]);
+            sumy += y[ib].qs[j];
+            sumy += y[ib].qs[j + qk/2];
+        }
+
+        const float scale = GGML_CPU_FP16_TO_FP32(x[ib].scale);
+        const float zero  = GGML_CPU_FP16_TO_FP32(x[ib].zero);
+        const float d     = GGML_CPU_FP16_TO_FP32(y[ib].d);
+        const float iscale = scale != 0.0f ? 1.0f / scale : 0.0f;
+
+        sumf += d * iscale * (sumi - zero * sumy);
+    }
+
+    *s = sumf;
+}
